    {
      "palette": {
        "Lavender": "blue",
        "Crust": "black",
        "Pink": "lighMagenta",
        "Flamingo": "magenta",
        "Rosewater": "cyan",
        "Yellow": "yellow",
        "Maroon": "red",
        "Peach": "lightYellow",
        "Red": "red"
      },
      "transient_prompt": {
          "background": "transparent",
          "foreground_templates": [
              "{{if gt .Code 0}}red{{end}}",
              "{{if eq .Code 0}}p:Lavender{{end}}"
            ],
          "template": "❯ "
      },
      "secondary_prompt": {
      	"template": "❯❯ ",
      	"foreground": "p:Lavender",
      	"background": "transparent"
      },
      "blocks": [
        {
          "type": "prompt",
          "alignment": "left",
          "segments": [
            {
              "properties": {
                "cache_duration": "none"
              },
              "template": " {{ if .WSL }}WSL in {{ end }}{{.Icon}} ",
              "foreground": "p:Lavender",
              "background": "p:Crust",
              "type": "os",
              "style": "powerline",
              "foreground_templates": [
                "{{ if .Root }}p:Pink{{ end }}"
              ]
            },
            {
              "properties": {
                "cache_duration": "none"
              },
              "template": " {{ .UserName }}@{{ .HostName }} ",
              "foreground": "p:Lavender",
              "background": "p:Crust",
              "powerline_symbol": "\ue0b4",
              "type": "session",
              "style": "powerline",
              "foreground_templates": [
                "{{ if .Root }}p:Pink{{ end }}"
              ]
            },
            {
              "properties": {
                "cache_duration": "none",
                "max_depth": 2,
                "style": "agnoster_short"
              },
              "template": "  {{ .Path }} ",
              "foreground": "p:Lavender",
              "powerline_symbol": "\ue0b4",
              "background": "p:Crust",
              "type": "path",
              "style": "powerline"
            }
          ],
          "newline": true
        },
        {
          "type": "prompt",
          "alignment": "left",
          "segments": [
            {
              "properties": {
                "always_enabled": true,
                "cache_duration": "none"
              },
              "template": "{{ if gt .Code 0 }}{{ .Code }}{{ end }}❯ ",
              "foreground": "p:Lavender",
              "type": "exit",
              "style": "plain",
              "foreground_templates": [
                "{{ if gt .Code 0 }}p:Red{{ end }}"
              ]
            }
          ],
          "newline": true
        }
      ],
      "version": 3
    }
